# ─────────────────────────────────────────────────────────────
# IDCUBE Proposal System – environment variables
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` or any credential file to source control.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Local development uses SQLite (zero setup).
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL / Supabase) – see docs/DEPLOYMENT.md:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/idcube_proposals?schema=public"

# ── Authentication ──────────────────────────────────────────
# Long random string used to sign session cookies (min 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Session lifetime in hours
SESSION_HOURS=12

# ── Google Sheets product master (server-side only) ─────────
# Leave GOOGLE_SHEETS_SPREADSHEET_ID empty to use the bundled sample
# file data/product-master-sample.csv (demo mode).
GOOGLE_SHEETS_SPREADSHEET_ID=""
# Tab name that holds the product master
GOOGLE_SHEETS_TAB_NAME="Products"
# Service account credentials – use EITHER the JSON file path OR the two inline values.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Paste the private key with literal \n line breaks, wrapped in double quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Auto-refresh interval: product data older than this is re-synced from the sheet.
SHEETS_SYNC_TTL_SECONDS=300
# Write new products added in the app back to the Google Sheet (needs Editor access)
SHEETS_WRITE_BACK="true"

# ── Email (SMTP) ────────────────────────────────────────────
# Works with Google Workspace (smtp.gmail.com + App Password), Microsoft 365
# (smtp.office365.com), Amazon SES, SendGrid, Brevo, Zoho, etc.
# Leave SMTP_HOST empty to disable sending (download-only mode).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="IDCUBE Sales <sales@your-domain.example>"
# Optional: copy every proposal email to this mailbox
EMAIL_BCC=""

# ── App ─────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
